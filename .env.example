# 複製為 .env 後填寫；留空即代表不啟用該引擎。

# --- GPT-SoVITS（api_v2.py）---
# CANTONESE_GPT_SOVITS_URL=http://127.0.0.1:9880
# CANTONESE_GPT_SOVITS_REF=/absolute/path/to/reference.wav
# CANTONESE_GPT_SOVITS_PROMPT=參考音頻對應的文字

# --- CosyVoice 3（runtime/python/fastapi/server.py）---
# CANTONESE_COSYVOICE_URL=http://127.0.0.1:50000
# CANTONESE_COSYVOICE_SPK=中文女

# --- Qwen3-TTS（阿里雲百煉 DashScope，可用頁面 Key 輸入框取代）---
# CANTONESE_DASHSCOPE_KEY=sk-...
# CANTONESE_QWEN_MODEL=qwen3-tts-flash
# CANTONESE_QWEN_LANG=Chinese
# CANTONESE_QWEN_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# --- 任意 OpenAI 兼容 /v1/audio/speech 服務（非免費，按量收費；可留空）---
# CANTONESE_OPENAI_URL=http://127.0.0.1:9000
# CANTONESE_OPENAI_KEY=sk-...
# CANTONESE_OPENAI_MODEL=tts-1
# CANTONESE_OPENAI_VOICE=alloy

# --- 本地模型路徑（可選）---
# CANTONESE_CANTO_MODEL=./.cache/canto-model
# CANTONESE_SHERPA_DIR=./.cache/sherpa
# CANTONESE_EKHO_BIN=/usr/local/bin/ekho

# --- 其他 ---
# CANTONESE_MAX_TEXT=2000
# CANTONESE_SYNTH_TIMEOUT=120
# CANTONESE_CACHE_DIR=/tmp/cantonese-cache
